# Copy to .env and fill in. .env is gitignored - never commit real credentials.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# The Gmail account the digest is sent FROM
SMTP_USER=your.address@gmail.com

# Gmail app password (16 chars, spaces optional) - NOT your account password.
# Requires 2-Step Verification: https://myaccount.google.com/apppasswords
SMTP_PASSWORD=xxxxxxxxxxxxxxxx

MAIL_FROM=your.address@gmail.com
MAIL_TO=Taha.mmtlmu@gmail.com

# ---------------------------------------------------------------------------
# Optional: the voice layer.
# Set ONE of these to get the digest written as commentary in the style
# defined in PREFERENCES.md. With neither set you get a plain link digest.
# ---------------------------------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# Override the auto-detected provider or model if you want:
# LLM_PROVIDER=anthropic     # anthropic | openai | none
# LLM_MODEL=claude-sonnet-4-5
